{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stateofpixel-images-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "r2_buckets": [
    { "binding": "IMAGES", "bucket_name": "stateofpixel-images-dev" }
  ],
  "env": {
    "production": {
      "name": "stateofpixel-images",
      "r2_buckets": [
        { "binding": "IMAGES", "bucket_name": "stateofpixel-images" }
      ]
    }
  }
}
