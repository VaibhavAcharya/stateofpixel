{
  "compilerOptions": {
    "strict": true,
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "target": "ES2022",
    "lib": ["ES2022", "dom"],
    "module": "ESNext",
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client"]
  },
  "include": ["src", "scripts", "drizzle.config.ts"]
}
